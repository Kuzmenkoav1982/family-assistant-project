    },
    {
      "name": "Unauthorized request rejected",
      "method": "POST",
      "path": "/",
      "body": {
        "child_id": 1,
        "family_id": 1,
        "age_range": "1-2",
        "skills": [
          {
            "category": "Крупная моторика",
            "skill_name": "Самостоятельно ходит",
            "skill_level": "confident"
          }
        ]
      },
      "expectedStatus": 401
    }
  ]
