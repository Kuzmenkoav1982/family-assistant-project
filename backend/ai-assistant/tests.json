{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET status (public healthcheck, no data)",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"status": "ok"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Wallet drain via client familyId -> 401 (no charge without session)",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {
        "familyId": "ca92a40b-8e92-4709-9dca-54f52f86d364",
        "userId": "00000000-0000-0000-0000-000000000001",
        "messages": [{"role": "user", "content": "test"}]
      },
      "expectedStatus": 401
    },
    {
      "name": "Spoofed X-User-Id without session -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json", "X-User-Id": "00000000-0000-0000-0000-000000000011"},
      "body": {"messages": [{"role": "user", "content": "test"}]},
      "expectedStatus": 401
    },
    {
      "name": "Invalid session token -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json", "X-Auth-Token": "invalid-token-for-negative-test"},
      "body": {"messages": [{"role": "user", "content": "test"}]},
      "expectedStatus": 401
    }
  ]
}
