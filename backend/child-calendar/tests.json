{
  "tests": [
    {
      "name": "Read without session -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {"action": "get_child_events", "childId": "00000000-0000-0000-0000-000000000013"},
      "expectedStatus": 401
    },
    {
      "name": "Spoofed X-User-Id without session -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json", "X-User-Id": "00000000-0000-0000-0000-000000000011"},
      "body": {"action": "get_child_events", "childId": "00000000-0000-0000-0000-000000000013"},
      "expectedStatus": 401
    },
    {
      "name": "Invalid session token -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json", "X-Auth-Token": "invalid-token-for-negative-test"},
      "body": {"action": "get_child_events", "childId": "00000000-0000-0000-0000-000000000013"},
      "expectedStatus": 401
    },
    {
      "name": "Client-supplied familyId without session -> 401 (no cross-family write)",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {
        "action": "add_child_event",
        "familyId": "ca92a40b-8e92-4709-9dca-54f52f86d364",
        "childId": "f0b4b417-9228-4d98-a0e1-65ba92a4ea2f",
        "event": {"title": "Injected", "date": "2026-01-15"}
      },
      "expectedStatus": 401
    },
    {
      "name": "Delete without session -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {"action": "delete_child_event", "eventId": "00000000-0000-0000-0000-000000000099"},
      "expectedStatus": 401
    },
    {
      "name": "Unknown action still requires session first -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {"action": "invalid_action"},
      "expectedStatus": 401
    },
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "headers": {},
      "expectedStatus": 200
    }
  ]
}
