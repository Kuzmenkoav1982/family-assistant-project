{
  "tests": [
    {
      "name": "OPTIONS request for CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "No token -> 401",
      "method": "GET",
      "path": "/?child_id=3f1aa585-176f-4ec0-85d0-7973d36de053&type=health",
      "expectedStatus": 401
    },
    {
      "name": "Fake token is no longer accepted -> 401 (was 200: presence-only check)",
      "method": "GET",
      "path": "/?child_id=3f1aa585-176f-4ec0-85d0-7973d36de053&type=all",
      "headers": {"X-Auth-Token": "test-token"},
      "expectedStatus": 401
    },
    {
      "name": "Health record enumeration by child_id -> 401",
      "method": "GET",
      "path": "/?child_id=f0b4b417-9228-4d98-a0e1-65ba92a4ea2f&type=health",
      "headers": {"X-Auth-Token": "invalid-token-for-negative-test"},
      "expectedStatus": 401
    },
    {
      "name": "Spoofed X-User-Id without session -> 401",
      "method": "GET",
      "path": "/?child_id=3f1aa585-176f-4ec0-85d0-7973d36de053&type=health",
      "headers": {"X-User-Id": "00000000-0000-0000-0000-000000000011"},
      "expectedStatus": 401
    },
    {
      "name": "Write vaccination with fake token -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"X-Auth-Token": "test-token", "Content-Type": "application/json"},
      "body": {
        "action": "add",
        "child_id": "3f1aa585-176f-4ec0-85d0-7973d36de053",
        "type": "vaccination",
        "data": {"date": "2026-05-16", "vaccine": "Тест", "family_id": "d551699f-ccdc-431c-8ff0-6910bba3f6d9"}
      },
      "expectedStatus": 401
    },
    {
      "name": "Cross-family family_id in body without session -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {
        "action": "add",
        "child_id": "f0b4b417-9228-4d98-a0e1-65ba92a4ea2f",
        "type": "vaccination",
        "data": {"date": "2026-01-01", "vaccine": "Injected", "family_id": "00000000-0000-0000-0000-000000000001"}
      },
      "expectedStatus": 401
    },
    {
      "name": "Write without session -> 401",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {
        "action": "add",
        "child_id": "3f1aa585-176f-4ec0-85d0-7973d36de053",
        "type": "dream",
        "data": {"title": "no session", "achieved": false}
      },
      "expectedStatus": 401
    }
  ]
}
